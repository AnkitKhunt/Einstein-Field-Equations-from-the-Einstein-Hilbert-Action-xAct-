   Editable->False]}]], "Output",
 CellChangeTimes->{4.0021529736656923`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"2a6b5fc1-ea3b-4681-a530-29717ffd4a99"]
}, Open  ]]
}, Open  ]],

