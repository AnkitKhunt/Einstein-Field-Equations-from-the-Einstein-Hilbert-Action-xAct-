Cell[CellGroupData[{

Cell["2. Fields and constants", "Section",ExpressionUUID->"421c564e-44c3-43ff-bc75-1a8a32a40450"],

Cell[CellGroupData[{

Cell["\<\
DefConstantSymbol[kap, PrintAs -> \"\[Kappa]\"];
DefScalarFunction[V];
DefTensor[phi[], M, PrintAs -> \"\[Phi]\"];
DefTensor[A[-a], M];
DefTensor[Fa[-a, -b], M, Antisymmetric[{-a, -b}], PrintAs -> \"F\"];
(* F_ab = nabla_a A_b - nabla_b A_a *)
FRule = Fa[-a_, -b_] :> CD[-a][A[-b]] - CD[-b][A[-a]];\
\>", "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"0b11cfdf-7679-474b-b251-070efcc163d6"],

