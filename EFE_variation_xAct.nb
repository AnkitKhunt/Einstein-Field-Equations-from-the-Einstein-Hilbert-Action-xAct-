Notebook[{

Cell[CellGroupData[{
Cell["\<\
Einstein Field Equations from the Einstein-Hilbert Action (xAct)\
\>", "Title",ExpressionUUID->"5dae98be-3f79-4c5b-a51c-143793ebe2e4"],

Cell["\<\
S = \[Integral] d\:2074x \[Sqrt](-g) [ R/(2\[Kappa]) + L_matter ],  \[Kappa] \
= 8\[Pi]G (c = 1), signature (-,+,+,+), no cosmological constant. Requires \
the xAct package (xTensor). Run cells top to bottom with Shift+Enter in the \
same kernel session.\
\>", "Text",ExpressionUUID->"668d6f34-3948-4eb1-84b1-5fc76ea9d28b"],

Cell["Author: Ankit C Khunt", "Text",ExpressionUUID->"69f9bad3-945b-447f-9858-de6bfae55191"],

Cell[CellGroupData[{

Cell["0. Load package", "Section",ExpressionUUID->"606b5e0c-c78b-44ed-b6cb-ad1f3e6181bf"],

Cell["\<\
Optional: run this first for a fresh kernel (then evaluate the next cell).\
\>", "Text",ExpressionUUID->"e91c83bb-c692-4690-97a2-45dc2aa6a4df"],

Cell["Quit[]", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"e50030d8-cacd-4876-b6f9-2bd19ffd96bb"],

Cell[CellGroupData[{

Cell["\<\
<< xAct`xTensor`
$PrePrint = ScreenDollarIndices;
$CVVerbose = False;\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"5e003a3d-9bac-4cd7-9d07-ab3e5f7dbdcf"],

