Cell[CellGroupData[{

Cell["3. Lagrangian densities", "Section",ExpressionUUID->"af0cb5a4-0b8b-4a8e-915f-f6427ad202e1"],

Cell["\<\
sqrtg = Sqrt[-Detg[]];

LGrav = RicciScalarCD[]/(2 kap);

LScalar = -1/2 g[a, b] CD[-a][phi[]] CD[-b][phi[]] - V[phi[]];

LMaxwell = (-1/4) g[a, c] g[b, d] Fa[-a, -b] Fa[-c, -d] /. FRule;\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"7753672c-e9b8-482c-8690-35ed08a2d728"],

Cell["\<\
Choose the matter sector: LScalar, LMaxwell, or LScalar + LMaxwell.\
\>", "Text",ExpressionUUID->"7b1ae260-92a5-4f87-a0a5-5534ac18a564"],

Cell["\<\
LMatter = LScalar;
LTotal = sqrtg (LGrav + LMatter);\
\>", "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"0f8c7884-21df-4486-b742-4f6205137ad8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Variation with respect to the inverse metric g^{ab}", "Section",ExpressionUUID->"978a053e-9b1e-4f69-b39b-2d6a51430824"],

Cell["\<\
VarD integrates by parts (boundary terms dropped). \[Delta]S = \[Integral]\
\[Sqrt](-g) [ G_ab/(2\[Kappa]) - T_ab/2 ] \[Delta]g^{ab}, so the field \
equations are G_ab - \[Kappa] T_ab = 0.\
\>", "Text",ExpressionUUID->"5872ec68-11b9-4846-8917-bb731f8de793"],

Cell["\<\
Simp[expr_] := expr // ContractMetric // ToCanonical // ScreenDollarIndices;\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"334c19de-6466-44f5-a87b-89f9a764f0c6"],

Cell["EOMmetric = Simp[VarD[g[a, b], CD][LTotal]/sqrtg];", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"bfe41858-9808-41ca-aea5-addaa0793d0d"],

Cell[CellGroupData[{

Cell["EFE = Simp[2 kap EOMmetric]", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"8ec4fbf3-3741-4dc3-bda3-ac21de5ac33a"],

