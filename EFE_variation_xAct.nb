Cell[CellGroupData[{

Cell["10. Easy modifications", "Section",ExpressionUUID->"ac7dc8b9-14cb-498e-aeb9-cbb22405b791"],

Cell["\<\
f(R) gravity: DefScalarFunction[fR]; LGrav = fR[RicciScalarCD[]]/(2 kap). \
Quadratic terms: LGrav += al RicciScalarCD[]^2. Non-minimal coupling: LMatter \
+= xi RicciScalarCD[] phi[]^2. Re-run sections 3 onward after changing.\
\>", "Text",ExpressionUUID->"afa6f3a3-641f-4777-b6c8-2853d3a377dd"]
}, Open  ]]
}, Open  ]]
